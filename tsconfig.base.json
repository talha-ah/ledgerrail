{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true, // ESM/CJS import hygiene — good discipline
    "strict": true,
    "noUncheckedIndexedAccess": true
  },
  "exclude": ["**/*.test.ts"] // don't emit test files
}
